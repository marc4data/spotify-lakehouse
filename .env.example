# spotify-lakehouse credentials — TEMPLATE ONLY.
# The real file is ~/.config/spot/.env (chmod 600), outside every checkout.
# `make bootstrap` creates it from this template. Never put a real value in this file.

# developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=replace-me
SPOTIFY_CLIENT_SECRET=replace-me
# Must match the dashboard Redirect URI character for character.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000

# Local Docker Postgres. Bootstrap generates a random password when it creates the real file.
SPOT_PG_USER=spot
SPOT_PG_PASSWORD=replace-me

# MusicBrainz genre resolver (`spot resolve-musicbrainz`). MusicBrainz blocks clients without contact
# info in the User-Agent: an email address or a URL where you can be reached. Real value only in
# ~/.config/spot/.env, never here.
MUSICBRAINZ_CONTACT=replace-me

# Optional: extra comma-separated email domains the pre-commit hook rejects.
SPOT_BLOCKED_EMAIL_DOMAINS=
